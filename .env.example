# ─────────────────────────────────────────────────────────────────────────────
# Immanuel configuration. Copy to `.env` for local runs; on Railway set these as
# service variables (Settings → Variables). None are committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# --- Discord (required to run the bot; leave empty to run API + crawler only) ---
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# Optional: your server (guild) ID. If set, slash commands sync instantly to that
# guild; if empty, commands sync globally (can take up to ~1 hour the first time).
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run control commands
# (/start /pause /stop /addsource /channel management, etc.). If empty, anyone
# with the Discord "Administrator" permission may use them.
MASTER_ADMIN_IDS=

# --- Storage ---
# SQLite path. On Railway, attach a Volume and point this inside it to persist data.
DATABASE_PATH=./data/immanuel.db

# --- HTTP API ---
# Railway sets PORT automatically; locally defaults to 8000.
PORT=8000
API_HOST=0.0.0.0
# Public base URL of your deployment (used in /apikey help text). Optional.
PUBLIC_BASE_URL=

# --- Crawler ("the algorithm") ---
IMMANUEL_USER_AGENT=ImmanuelBot/1.0 (+https://github.com/shep95/Immanuel)
# Crawler mode:
#   swarm = spawn a NEW crawler-agent per page/link discovered (dynamic, fastest)
#   cycle = fixed worker pool draining per-cycle batches (steadier, simpler)
CRAWLER_MODE=swarm
# SWARM: max concurrent crawler-agents. Agents are async I/O tasks (cheap); the
# real limit is per-domain politeness below. Guide: 50 light, 200 busy, 500 heavy.
MAX_AGENTS=50
FRONTIER_MAX=20000          # max URLs waiting for an agent (bounded; overflow -> DB)
VISITED_MAX=200000          # in-memory recently-seen URL cap (bounds memory)

# CYCLE mode: number of parallel workers. Guide: 8 light, 16 busy, 32 heavy.
NUM_CRAWLERS=8
CRAWL_CONCURRENCY=4
CRAWL_DELAY_SECONDS=2
MAX_PAGES_PER_CYCLE=25
CYCLE_INTERVAL_SECONDS=30
# How often a page is revisited to detect updates (seconds). 3600 = hourly.
RECRAWL_INTERVAL_SECONDS=3600
MAX_LINKS_PER_PAGE=20
REQUEST_TIMEOUT_SECONDS=20
MAX_CONTENT_BYTES=5000000
RESPECT_ROBOTS=true

# Auto source discovery — with this ON (default) Immanuel loads a built-in set
# of link-rich public "firehose" pages/feeds on start, so it finds its OWN
# domains and sources with zero input. You do NOT need to add sources; /addsource
# and SEED_URLS just add extra ones.
AUTO_DISCOVER=true

# How many hops to follow links out from each root/domain (the "3-way hop":
# root=0 -> its links=1 -> their links=2 -> their links=3). Higher = wider reach
# but far more pages. 3 is a sensible default.
MAX_HOPS=3

# Certificate-Transparency domain firehose: continuously discover domains across
# the whole web (from public TLS certificate logs) in batches. OFF by default —
# it finds domains FAR faster than one node can crawl. Turn on only if you have
# the capacity (ideally multiple replicas + Postgres). robots.txt still respected.
ENABLE_CT_DISCOVERY=false
CT_BATCH_SIZE=200
CT_POLL_SECONDS=120

# Probe common subdomains (blog., api., docs., …) and common paths for each seed
# — finds hosts/pages that are not linked or indexed anywhere (non-SEO targets).
ENABLE_SUBDOMAIN_PROBE=false

# Post collected items and page updates into your Discord server's channels
# (Immanuel hosts the data on Discord under a "📚 Immanuel Data" category).
PUBLISH_TO_DISCORD=true

# Start crawling automatically on boot (otherwise wait for /start in Discord).
AUTOSTART_CRAWLER=false

# Comma-separated seed URLs to begin discovery from (optional; you can also add
# them at runtime with /addsource).
SEED_URLS=

# --- Timeline / historical collection (Internet Archive Wayback Machine) ---
# When true, seeds are also expanded with historical captures from the public
# Wayback CDX API ("since the site was founded to present"). Forward crawling
# ("future days") happens automatically as the crawler runs 24/7.
ENABLE_WAYBACK=false
WAYBACK_MAX_SNAPSHOTS=25

# ─────────────────────────────────────────────────────────────────────────────
# Deep acquisition — scrape text + full metadata + code + media (not just links)
# ─────────────────────────────────────────────────────────────────────────────
DEEP_EXTRACT=true            # capture full page metadata + code assets
# Scan PUBLIC pages for exposed API keys / secrets -> reported to a PRIVATE
# admin-only Discord channel (#asherin-api-keys). Values are masked; the raw
# secret is never stored (only a sha256 fingerprint + masked preview).
SCAN_SECRETS=true
BUILD_INTEL_REPORT=true      # per-page intel data-report (open metadata + link graph)

# --- Media download & import (download files, convert YouTube -> transcripts) ---
# Downloads media bytes to disk (content-addressed). Needs disk + (for image
# metadata) the optional Pillow dependency. OFF by default.
DOWNLOAD_MEDIA=false
MEDIA_STORE_PATH=./data/media
MAX_MEDIA_BYTES=25000000
MAX_MEDIA_PER_PAGE=20
MEDIA_TYPES=image,audio,video,document,archive
# Sort EVERY file type + youtube transcripts into their own PUBLIC channels
# (📁 asherin media -> media-images/audio/video/documents/archives/files,
#  🎬 asherin youtube -> asherin-transcripts). Works even when DOWNLOAD_MEDIA is
# off — references are still categorized. Pre-create with /setup_media_channels.
PUBLISH_MEDIA=true
PUBLISH_TRANSCRIPTS=true

# --- /hack: AI pentest (Strix) + deterministic recon fallback ---
ENABLE_HACK=true
# auto = Strix when runnable (docker + LLM key), else recon. Force: strix | recon
HACK_ENGINE=auto
HACK_RUNS_PATH=./data/hack
HACK_TIMEOUT_SECONDS=1800
HACK_MAX_RECON_PAGES=25
HACK_RECON_HOPS=1
# Pattern Forge thinking architecture: mount immanuel/hack/brains/* into the
# Strix sandbox + compose them into the AI hacker's operating instruction.
# Store + show the FULL uncensored value of leaked keys on ADMIN-ONLY surfaces
# (secrets channel, /secrets, /v1/secrets). Default false = masked + fingerprint.
# This never USES a key; it only keeps the value in your private admin ledger.
SECRETS_UNCENSORED=false
HACK_THINKING_ARCH=true
# Let users PASTE their /hack key straight into their private channel. This is a
# PRIVILEGED intent: leave false unless you've enabled "Message Content Intent"
# in the Discord Developer Portal. When false, users set keys via /hackkey
# (ephemeral) instead — the bot still boots either way.
DISCORD_MESSAGE_CONTENT=false
# Strix engine (optional — pip install -r requirements-hack.txt + Docker):
STRIX_BIN=strix
STRIX_SCAN_MODE=standard
STRIX_MAX_BUDGET_USD=2.0
STRIX_MAX_TURNS=0
# Users bring their OWN key by pasting it into their private /hack channel.
# These are only a fallback default model when a user pastes just a key:
# STRIX_LLM=openrouter/z-ai/glm-5.3
# LLM_API_KEY=your-api-key
# YouTube: convert videos -> transcripts + import thumbnails.
# Transcripts need the optional `youtube-transcript-api` package (see
# requirements-optional.txt); without it, only the thumbnail + id are captured.
ENABLE_YOUTUBE=true
YOUTUBE_LANGS=en

# --- Organization: per-company / per-topic channels & categories ---
# epistemic (default 5 buckets) | topic | company
ORGANIZE_BY=epistemic
MAX_DYNAMIC_CHANNELS=180      # guardrail (Discord: 500/guild, 50/category)

# --- Pattern Forge (second, non-AI algorithm — learns patterns 24/7) ---
ENABLE_PATTERN_FORGE=true
PATTERN_FORGE_INTERVAL_SECONDS=300
PATTERN_MIN_EVIDENCE=3
PATTERN_MIN_CONFIDENCE_PCT=60   # promote candidate -> validated at/above this %
SKILLS_EXPORT_PATH=./data/skills

# --- GitHub tool scout (find useful osint/cyber/hacking/surveillance/red-team repos) ---
# Continuously scans PUBLIC GitHub for real software/algorithms in these families
# and drops each find (link + name + description + how it's useful) into a PRIVATE
# channel only the server owner + the bot can see (#asherin-github-tools).
ENABLE_GITHUB_SCOUT=true
# Optional: a token raises the search rate limit (zero-touch — used only if set).
# GITHUB_TOKEN=
GITHUB_SCOUT_INTERVAL_SECONDS=900
GITHUB_CATEGORIES=osint,cyber-security,hacking,surveillance,red-team
GITHUB_MIN_STARS=5
GITHUB_PER_CATEGORY=30
GITHUB_MAX_PER_PASS=60
