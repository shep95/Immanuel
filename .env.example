# ─────────────────────────────────────────────────────────────────────────────
# Immanuel configuration. Copy to `.env` for local runs; on Railway set these as
# service variables (Settings → Variables). None are committed to git.
# ─────────────────────────────────────────────────────────────────────────────

# --- Discord (required to run the bot; leave empty to run API + crawler only) ---
# Bot token from https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=

# Optional: your server (guild) ID. If set, slash commands sync instantly to that
# guild; if empty, commands sync globally (can take up to ~1 hour the first time).
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to run control commands
# (/start /pause /stop /addsource /channel management, etc.). If empty, anyone
# with the Discord "Administrator" permission may use them.
MASTER_ADMIN_IDS=

# --- Storage ---
# SQLite path. On Railway, attach a Volume and point this inside it to persist data.
DATABASE_PATH=./data/immanuel.db

# --- HTTP API ---
# Railway sets PORT automatically; locally defaults to 8000.
PORT=8000
API_HOST=0.0.0.0
# Public base URL of your deployment (used in /apikey help text). Optional.
PUBLIC_BASE_URL=

# --- Crawler ("the algorithm") ---
IMMANUEL_USER_AGENT=ImmanuelBot/1.0 (+https://github.com/shep95/Immanuel)
# Crawler mode:
#   swarm = spawn a NEW crawler-agent per page/link discovered (dynamic, fastest)
#   cycle = fixed worker pool draining per-cycle batches (steadier, simpler)
CRAWLER_MODE=swarm
# SWARM: max concurrent crawler-agents. Agents are async I/O tasks (cheap); the
# real limit is per-domain politeness below. Guide: 50 light, 200 busy, 500 heavy.
MAX_AGENTS=50
FRONTIER_MAX=20000          # max URLs waiting for an agent (bounded; overflow -> DB)
VISITED_MAX=200000          # in-memory recently-seen URL cap (bounds memory)

# CYCLE mode: number of parallel workers. Guide: 8 light, 16 busy, 32 heavy.
NUM_CRAWLERS=8
CRAWL_CONCURRENCY=4
CRAWL_DELAY_SECONDS=2
MAX_PAGES_PER_CYCLE=25
CYCLE_INTERVAL_SECONDS=30
# How often a page is revisited to detect updates (seconds). 3600 = hourly.
RECRAWL_INTERVAL_SECONDS=3600
MAX_LINKS_PER_PAGE=20
REQUEST_TIMEOUT_SECONDS=20
MAX_CONTENT_BYTES=5000000
RESPECT_ROBOTS=true

# Auto source discovery — with this ON (default) Immanuel loads a built-in set
# of link-rich public "firehose" pages/feeds on start, so it finds its OWN
# domains and sources with zero input. You do NOT need to add sources; /addsource
# and SEED_URLS just add extra ones.
AUTO_DISCOVER=true

# How many hops to follow links out from each root/domain (the "3-way hop":
# root=0 -> its links=1 -> their links=2 -> their links=3). Higher = wider reach
# but far more pages. 3 is a sensible default.
MAX_HOPS=3

# Certificate-Transparency domain firehose: continuously discover domains across
# the whole web (from public TLS certificate logs) in batches. OFF by default —
# it finds domains FAR faster than one node can crawl. Turn on only if you have
# the capacity (ideally multiple replicas + Postgres). robots.txt still respected.
ENABLE_CT_DISCOVERY=false
CT_BATCH_SIZE=200
CT_POLL_SECONDS=120

# Probe common subdomains (blog., api., docs., …) and common paths for each seed
# — finds hosts/pages that are not linked or indexed anywhere (non-SEO targets).
ENABLE_SUBDOMAIN_PROBE=false

# Post collected items and page updates into your Discord server's channels
# (Immanuel hosts the data on Discord under a "📚 Immanuel Data" category).
PUBLISH_TO_DISCORD=true

# Start crawling automatically on boot (otherwise wait for /start in Discord).
AUTOSTART_CRAWLER=false

# Comma-separated seed URLs to begin discovery from (optional; you can also add
# them at runtime with /addsource).
SEED_URLS=

# --- Timeline / historical collection (Internet Archive Wayback Machine) ---
# When true, seeds are also expanded with historical captures from the public
# Wayback CDX API ("since the site was founded to present"). Forward crawling
# ("future days") happens automatically as the crawler runs 24/7.
ENABLE_WAYBACK=false
WAYBACK_MAX_SNAPSHOTS=25
